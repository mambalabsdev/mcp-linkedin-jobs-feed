{
  "name": "@mambalabsdev/mcp-linkedin-jobs-feed",
  "version": "1.0.0",
  "description": "MCP server for LinkedIn Jobs Feed. Search LinkedIn jobs by keyword and location and get one row per job with the employer website domain, description, seniority, and applicants. No login. Runs on Apify. Clay-ready output.",
  "type": "module",
  "bin": {
    "mcp-linkedin-jobs-feed": "./build/index.js"
  },
  "files": [
    "build",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "tsc && chmod +x build/index.js",
    "test": "npm run build && node --test test/*.test.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "linkedin-jobs",
    "jobs",
    "job-search",
    "hiring-signals",
    "company-domain",
    "apify",
    "clay"
  ],
  "author": "Mamba Labs <labs@mambamindsetgrowth.com>",
  "license": "MIT",
  "homepage": "https://apify.com/mambalabs/linkedin-jobs-feed",
  "repository": {
    "type": "git",
    "url": "https://github.com/mambalabsdev/mcp-linkedin-jobs-feed"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "5.9.3"
  },
  "mcpName": "com.mambabuilt/mcp-linkedin-jobs-feed"
}
